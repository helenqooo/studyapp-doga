# Copy to server/.env and fill in. Never commit .env.

# Anthropic API key — lives ONLY here, never in the mobile app.
ANTHROPIC_API_KEY=sk-ant-...

# Model used for solving / parsing.
AI_MODEL=claude-sonnet-5-5
# Optional: low | medium | high | xhigh | max (empty = model default).
AI_EFFORT=

# Shared secret the app sends as "Authorization: Bearer <APP_TOKEN>".
# Generate one with: openssl rand -hex 32
APP_TOKEN=change-me-to-a-long-random-string

HOST=0.0.0.0
PORT=3000

# Day boundaries (streaks, review due dates) use this timezone.
APP_TIMEZONE=Europe/Istanbul

# Where the SQLite DB and question images are stored (default: server/data).
# DATA_DIR=./data

# true = canned AI responses (solve + "Anlamadım" chat) without calling Claude (UI testing, no API cost).
MOCK_SOLVER=false
