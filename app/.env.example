# Copy to app/.env and fill in. Restart `npx expo start` after changes.
# Only EXPO_PUBLIC_* values reach the app. Never put ANTHROPIC_API_KEY here.

# Backend URL as the phone sees it (VDS IP/domain, no trailing slash).
EXPO_PUBLIC_API_URL=http://your-vds-ip:3000

# Leave EXPO_PUBLIC_API_URL empty (or set EXPO_PUBLIC_DEMO=1) to run on sample data without a server.
# EXPO_PUBLIC_DEMO=1
